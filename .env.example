# Local Postgres credentials match docker-compose.yml. Do not use in production.
DATABASE_URL="postgresql://kartify:kartify@localhost:5433/kartify?schema=public"
# Dedicated disposable database; must differ from DATABASE_URL and end in _test.
TEST_DATABASE_URL="postgresql://kartify:kartify@localhost:5433/kartify_test?schema=public"
# Generate locally: openssl rand -base64 32. Keep stable across restarts/instances.
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
# Change this together with the database URLs if port 5433 is occupied.
POSTGRES_PORT=5433

# Enable only behind a trusted reverse proxy that overwrites x-forwarded-for.
# Without it, all requests share the auth limit (10 attempts/minute/process).
AUTH_TRUST_PROXY="false"
